<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>FaceHelper</AssemblyName>
    <RootNamespace>DynamicIsland.FaceHelper</RootNamespace>
    <NoWarn>CS9057</NoWarn>
    <Version>1.5.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../FaceId/FaceEngine.cs;../FaceId/FaceLogic.cs;../FaceId/FaceStore.cs;../FaceId/FaceCamera.cs;../FaceId/FaceLog.cs" />
    <Compile Include="../FaceId/SignInSecret.cs" />
    <Compile Include="../FaceId/PhoneTrust.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
