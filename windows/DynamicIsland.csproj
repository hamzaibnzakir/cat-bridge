<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>DynamicIsland</AssemblyName>
    <ApplicationIcon>Installer\app.ico</ApplicationIcon>
    <RootNamespace>DynamicIsland</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.3.0</Version>
    <Product>Dynamic Island for Windows</Product>
    <Company>Foluceen</Company>
    <NoWarn>WFAC010;CS9057</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="FaceHelper/**;FaceSignIn/**" />
    <None Remove="FaceHelper/**;FaceSignIn/**" />
    <Page Remove="FaceHelper/**;FaceSignIn/**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Bridge\web\*" LogicalName="bridge/%(Filename)%(Extension)" />
    <None Include="models\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.9.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <!-- The 37 MB face recognition model isn't kept in git: fetch it from the OpenCV model zoo on first build. -->
  <Target Name="FetchFaceModel" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildProjectDirectory)\models\face_recognition_sface_2021dec.onnx')">
    <Message Importance="high" Text="Downloading SFace face model (37 MB) from the OpenCV model zoo…" />
    <DownloadFile SourceUrl="https://media.githubusercontent.com/media/opencv/opencv_zoo/main/models/face_recognition_sface/face_recognition_sface_2021dec.onnx"
                  DestinationFolder="$(MSBuildProjectDirectory)\models" Retries="3" />
    <ItemGroup>
      <None Include="models\face_recognition_sface_2021dec.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Resource Include="Installer\app.ico" />
  </ItemGroup>
</Project>
